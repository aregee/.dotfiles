// Waybar — floating Dracula bar (2026-11-25)
{
    "reload_style_on_change": true,   // accent.css changes on every workspace switch: re-read the CSS in place, never restart the bar
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "margin-bottom": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/music", "group/stats", "tray"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "", "active": "", "urgent": "" },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'",
        "sort-by-number": true,
        "persistent-workspaces": { "DP-3": [1, 2, 3, 4, 5], "HDMI-A-1": [11, 12, 13] }
    },
    "hyprland/submap": { "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>󰌌</span> {}" },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Brave": "  $1",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "(.*) - VSCodium": "󰨞  $1"
        }
    },
    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month", "weeks-pos": "right",
            "format": { "today": "<span color='#bd93f9'><b>{}</b></span>", "weekdays": "<span color='#6272a4'>{}</span>" }
        }
    },
    "group/stats": {
        "orientation": "inherit",
        "drawer": { "transition-duration": 300, "transition-left-to-right": false, "children-class": "stat" },
        "modules": ["custom/stats-handle", "cpu", "temperature", "memory", "pulseaudio", "network"]
    },
    "custom/stats-handle": { "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'></span>", "tooltip": false },
    "custom/music": {
        "exec": "~/.config/waybar/music.sh",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "pkill -USR1 -f now-playing.py",
        "on-click-right": "deadbeef --toggle-pause",
        "on-scroll-down": "deadbeef --next",
        "on-scroll-up": "deadbeef --prev"
    },
    "cpu": { "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'></span> {usage}%", "interval": 2, "on-click": "kitty --class btop -e btop" },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'></span> {temperatureC}°"
    },
    "memory": { "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>󰍛</span> {percentage}%", "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },
    "disk": { "paths": ["/"], "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>󰋊</span> {percentage_used}%", "tooltip-format": "{used} / {total} on {path}" },
    "pulseaudio": {
        "format": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>{icon}</span> {volume}%",
        "format-muted": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>󰝟</span> mute",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },
    "network": {
        "format-ethernet": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>󰈀</span> wired",
        "format-wifi": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'></span> {essid}",
        "format-disconnected": "<span font_family='JetBrainsMono Nerd Font Propo' size='large' rise='-1pt'>󰖪</span> offline",
        "tooltip-format": "{ifname} {ipaddr}/{cidr}   {bandwidthDownBits}",
        "on-click": "nm-connection-editor"
    },
    "tray": { "icon-size": 16, "spacing": 10 }
}

/* rofi — Dracula glass, Inter (2026-11-25 premium pass) */
* {
    bg:        #282a36cc;
    bg-alt:    #44475a66;
    fg:        #f8f8f2;
    fg-dim:    #6272a4;
    accent:    #bd93f9;
    pink:      #ff79c6;
    background-color: transparent;
    text-color: @fg;
    font: "Inter 13";
}
@import "accent.rasi"   // accent + pink follow the wallpaper (wallpaper.sh)
window {
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 12px;
    width: 720px;
    padding: 0;
}
mainbox { padding: 18px; spacing: 14px; }
inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 12px;
}
prompt { text-color: @accent; font: "Inter Semi-Bold 13"; }
entry { placeholder: "Search"; placeholder-color: @fg-dim; cursor: text; }
listview { lines: 8; spacing: 4px; scrollbar: false; fixed-height: false; }
element { padding: 10px 14px; border-radius: 10px; spacing: 14px; }
element-icon { size: 1.5em; }
element selected { background-color: @accent; text-color: #282a36; }
element-text { text-color: inherit; vertical-align: 0.5; }
element alternate { background-color: transparent; }
message { padding: 8px; }
textbox { text-color: @fg-dim; }
mode-switcher { spacing: 8px; }
button { padding: 8px; border-radius: 8px; text-color: @fg-dim; }
button selected { background-color: @bg-alt; text-color: @accent; }

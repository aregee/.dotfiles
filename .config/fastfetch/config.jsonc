// fastfetch — Dracula-tinted, replaces neofetch (2026-11-24)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "manjaro", "padding": { "top": 1, "right": 3 }, "color": { "1": "38;2;189;147;249", "2": "38;2;139;233;253" } },
  "display": { "separator": "  ", "color": { "keys": "38;2;189;147;249", "title": "38;2;139;233;253" }, "constants": [ "─────────────────────────" ] },
  "modules": [
    "title",
    { "type": "custom", "format": "{#90}{$1}" },
    { "type": "os",       "key": "  OS" },
    { "type": "kernel",   "key": "  Kernel" },
    { "type": "uptime",   "key": "  Uptime" },
    { "type": "packages", "key": "  Packages" },
    { "type": "shell",    "key": "  Shell" },
    { "type": "wm",       "key": "  WM" },
    { "type": "terminal", "key": "  Terminal" },
    { "type": "display",  "key": "󰍹  Display" },
    { "type": "cpu",      "key": "  CPU" },
    { "type": "gpu",      "key": "󰢮  GPU" },
    { "type": "memory",   "key": "  Memory" },
    { "type": "disk",     "key": "󰋊  Disk" },
    { "type": "custom", "format": "{#90}{$1}" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
